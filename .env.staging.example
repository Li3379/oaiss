# =============================================
# OAISS Chain - Staging Environment Template
# Staging mirrors production topology but may load demo seed data.
# Do not commit filled values.
# =============================================

SPRING_PROFILES_ACTIVE=staging,fabric
LOG_LEVEL=INFO
APP_LOG_LEVEL=INFO

BACKEND_IMAGE=ghcr.io/example-org/oaiss-chain-backend:replace_with_staging_release_tag
FRONTEND_IMAGE=ghcr.io/example-org/oaiss-chain-frontend:replace_with_staging_release_tag
ML_SERVICE_IMAGE=ghcr.io/example-org/oaiss-chain-ml-service:replace_with_staging_release_tag

CORS_ALLOWED_ORIGINS=https://staging.example.com

DB_URL=jdbc:mysql://mysql-staging.example.internal:3306/oaiss_chain?useSSL=true&requireSSL=true&serverTimezone=Asia/Shanghai&characterEncoding=UTF-8
DB_USERNAME=oaiss_app_staging
DB_PASSWORD=replace_with_strong_staging_database_password
DB_POOL_MIN_IDLE=3
DB_POOL_MAX_SIZE=10
DB_POOL_CONNECTION_TIMEOUT_MS=30000
DB_POOL_LEAK_DETECTION_MS=0

REDIS_HOST=redis-staging.example.internal
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=replace_with_strong_staging_redis_password

JWT_SECRET=replace_with_strong_random_staging_jwt_secret
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000
RSA_KEK=replace_with_base64_encoded_32_byte_key

MINIO_ENDPOINT=https://object-storage-staging.example.internal
MINIO_ACCESS_KEY=replace_with_staging_minio_access_key
MINIO_SECRET_KEY=replace_with_staging_minio_secret_key
MINIO_BUCKET=oaiss-chain-staging
MINIO_PRESIGNED_URL_EXPIRY_SECONDS=1800

ML_LOG_LEVEL=INFO
ML_SERVICE_URL=http://ml-service:8001
ML_SERVICE_SECRET=replace_with_internal_staging_ml_service_secret
ML_SERVICE_CONNECT_TIMEOUT=5s
ML_SERVICE_READ_TIMEOUT=30s

REQUIRE_OPS_SECRETS=true
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace_with_strong_staging_grafana_password
ALERT_SMTP_HOST=
ALERT_SMTP_USERNAME=
ALERT_SMTP_PASSWORD=
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_SECRET=
BACKEND_LOG_DIR=./runtime-logs/backend
FRONTEND_LOG_DIR=./runtime-logs/frontend
ML_LOG_DIR=./runtime-logs/ml-service

FABRIC_ENABLED=true
FABRIC_MSP_ID=Org1MSP
FABRIC_CHANNEL_NAME=mychannel
FABRIC_CHAINCODE_NAME=carbon-chaincode
FABRIC_PEER_ENDPOINT=peer0.org1.staging.internal:7051
FABRIC_TLS_ENABLED=true
FABRIC_PEER_TLS_CERT_PATH=/run/secrets/fabric/peer-tls-ca.crt
FABRIC_CERT_PATH=/run/secrets/fabric/user-cert.pem
FABRIC_KEY_PATH=/run/secrets/fabric/user-key.pem
FABRIC_CA_ENABLED=false
FABRIC_CA_ENDPOINT=https://ca.org1.staging.internal:7054
FABRIC_CA_ADMIN_NAME=admin
FABRIC_CA_ADMIN_PASSWORD=replace_with_strong_staging_fabric_ca_password
FABRIC_COUCHDB_USER=admin
FABRIC_COUCHDB_PASSWORD=replace_with_strong_staging_couchdb_password
FABRIC_SECRETS_DIR=./secrets/fabric
FABRIC_SECRETS_MOUNT_PATH=/run/secrets/fabric
