# =============================================
# OAISS Chain Backend - Environment Variables Template
# Keep in sync with ../.env.example. Never commit real secrets.
# =============================================

SPRING_PROFILES_ACTIVE=local
LOG_LEVEL=INFO
APP_LOG_LEVEL=INFO

# ===== Database (MySQL) =====
DB_HOST=localhost
DB_PORT=3306
DB_NAME=oaiss_chain
DB_USERNAME=root
DB_PASSWORD=change_me_db_password
# Production profile should use DB_URL with TLS instead of host defaults:
# DB_URL=jdbc:mysql://mysql.example.internal:3306/oaiss_chain?useSSL=true&requireSSL=true&serverTimezone=Asia/Shanghai&characterEncoding=UTF-8
DB_POOL_MIN_IDLE=5
DB_POOL_MAX_SIZE=20
DB_POOL_CONNECTION_TIMEOUT_MS=30000
DB_POOL_LEAK_DETECTION_MS=0

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=change_me_redis_password

# ===== JWT Authentication =====
JWT_SECRET=change_me_to_a_random_256bit_secret
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000

# ===== RSA Private Key Encryption =====
# Must decode to exactly 32 bytes. Generate with: openssl rand -base64 32
RSA_KEK=change_me_base64_encoded_32_byte_key

# ===== MinIO =====
MINIO_ENDPOINT=http://localhost:9002
MINIO_ACCESS_KEY=change_me_minio_access_key
MINIO_SECRET_KEY=change_me_minio_secret_key
MINIO_BUCKET=oaiss-chain
MINIO_PRESIGNED_URL_EXPIRY_SECONDS=3600

# ===== CORS =====
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# ===== ML Service =====
ML_SERVICE_URL=http://localhost:8001
ML_SERVICE_SECRET=
ML_SERVICE_CONNECT_TIMEOUT=5s
ML_SERVICE_READ_TIMEOUT=30s

# ===== Operations / Monitoring =====
REQUIRE_OPS_SECRETS=false
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana_password
ALERT_SMTP_HOST=
ALERT_SMTP_USERNAME=
ALERT_SMTP_PASSWORD=
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_SECRET=

# ===== Fabric =====
FABRIC_ENABLED=false
FABRIC_MSP_ID=Org1MSP
FABRIC_CHANNEL_NAME=mychannel
FABRIC_CHAINCODE_NAME=carbon-chaincode
FABRIC_PEER_ENDPOINT=
FABRIC_TLS_ENABLED=true
FABRIC_PEER_TLS_CERT_PATH=
FABRIC_CERT_PATH=
FABRIC_KEY_PATH=
FABRIC_CA_ENABLED=false
FABRIC_CA_ENDPOINT=
FABRIC_CA_ADMIN_NAME=admin
FABRIC_CA_ADMIN_PASSWORD=change_me_fabric_ca_password
FABRIC_COUCHDB_USER=admin
FABRIC_COUCHDB_PASSWORD=change_me_couchdb_password
