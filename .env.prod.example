# =============================================
# OAISS Chain - Production Environment Template
# Copy outside the repository or into your secret manager. Do not commit filled values.
# =============================================

SPRING_PROFILES_ACTIVE=prod,fabric
LOG_LEVEL=INFO
APP_LOG_LEVEL=INFO

# ===== Published Release Images =====
BACKEND_IMAGE=ghcr.io/example-org/oaiss-chain-backend:replace_with_release_tag
FRONTEND_IMAGE=ghcr.io/example-org/oaiss-chain-frontend:replace_with_release_tag
ML_SERVICE_IMAGE=ghcr.io/example-org/oaiss-chain-ml-service:replace_with_release_tag

# ===== Public Origins =====
CORS_ALLOWED_ORIGINS=https://app.example.com

# ===== Database (MySQL) =====
DB_URL=jdbc:mysql://mysql.example.internal:3306/oaiss_chain?useSSL=true&requireSSL=true&serverTimezone=Asia/Shanghai&characterEncoding=UTF-8
DB_USERNAME=oaiss_app
DB_PASSWORD=replace_with_strong_database_password
DB_POOL_MIN_IDLE=5
DB_POOL_MAX_SIZE=20
DB_POOL_CONNECTION_TIMEOUT_MS=30000
DB_POOL_LEAK_DETECTION_MS=0

# ===== Redis =====
REDIS_HOST=redis.example.internal
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=replace_with_strong_redis_password

# ===== JWT / Key Encryption =====
# JWT: openssl rand -base64 48
JWT_SECRET=replace_with_strong_random_jwt_secret
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000
# RSA_KEK must decode to exactly 32 bytes: openssl rand -base64 32
RSA_KEK=replace_with_base64_encoded_32_byte_key

# ===== MinIO / Object Storage =====
MINIO_ENDPOINT=https://object-storage.example.internal
MINIO_ACCESS_KEY=replace_with_minio_access_key
MINIO_SECRET_KEY=replace_with_minio_secret_key
MINIO_BUCKET=oaiss-chain-prod
MINIO_PRESIGNED_URL_EXPIRY_SECONDS=1800

# ===== ML Service =====
ML_LOG_LEVEL=INFO
ML_SERVICE_URL=http://ml-service:8001
ML_SERVICE_SECRET=replace_with_internal_ml_service_secret
ML_SERVICE_CONNECT_TIMEOUT=5s
ML_SERVICE_READ_TIMEOUT=30s

# ===== Operations / Monitoring =====
REQUIRE_OPS_SECRETS=true
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace_with_strong_grafana_password
ALERT_SMTP_HOST=smtp.example.com
ALERT_SMTP_USERNAME=alerts@example.com
ALERT_SMTP_PASSWORD=replace_with_alert_smtp_password
ALERT_WEBHOOK_URL=https://alerts.example.com/webhook
ALERT_WEBHOOK_SECRET=replace_with_alert_webhook_secret
BACKEND_LOG_DIR=./runtime-logs/backend
FRONTEND_LOG_DIR=./runtime-logs/frontend
ML_LOG_DIR=./runtime-logs/ml-service

# ===== Fabric =====
FABRIC_ENABLED=true
FABRIC_MSP_ID=Org1MSP
FABRIC_CHANNEL_NAME=mychannel
FABRIC_CHAINCODE_NAME=carbon-chaincode
FABRIC_PEER_ENDPOINT=peer0.org1.example.internal:7051
FABRIC_TLS_ENABLED=true
FABRIC_PEER_TLS_CERT_PATH=/run/secrets/fabric/peer-tls-ca.crt
FABRIC_CERT_PATH=/run/secrets/fabric/user-cert.pem
FABRIC_KEY_PATH=/run/secrets/fabric/user-key.pem
FABRIC_CA_ENABLED=false
FABRIC_CA_ENDPOINT=https://ca.org1.example.internal:7054
FABRIC_CA_ADMIN_NAME=admin
FABRIC_CA_ADMIN_PASSWORD=replace_with_strong_fabric_ca_password
FABRIC_COUCHDB_USER=admin
FABRIC_COUCHDB_PASSWORD=replace_with_strong_couchdb_password
FABRIC_SECRETS_DIR=./secrets/fabric
FABRIC_SECRETS_MOUNT_PATH=/run/secrets/fabric
